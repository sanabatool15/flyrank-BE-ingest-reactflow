# OpenAI (or any OpenAI-compatible provider, e.g. OpenRouter)
OPENAI_API_KEY=
# Leave blank to use OpenAI directly, or set to a compatible provider's
# base URL, e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Leave blank for the default (gpt-4o-mini). With OpenRouter, use its
# model slug, e.g. openai/gpt-4o-mini or anthropic/claude-3.5-haiku
OPENAI_MODEL=

# Inngest
# Set to 1 for local development so the SDK talks to the local Inngest Dev
# Server instead of expecting production signing keys.
INNGEST_DEV=1

# Only needed when deploying (not for local dev)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
